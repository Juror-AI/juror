{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juror-marketing",
  "compatibility_date": "2026-08-22",
  "preview_urls": true,
  "routes": [
    {
      "pattern": "juror.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
